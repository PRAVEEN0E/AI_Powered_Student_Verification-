PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apaar_aicte_db

# Redis Configuration (For cross-institution duplicate enrollment distributed locks)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=super-secure-production-ready-apaar-aicte-secret-key-32chars
JWT_EXPIRES_IN=1d

# Allowed Frontend Origins (CORS)
FRONTEND_URL=http://localhost:3000
